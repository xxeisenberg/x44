# Shared authentication token to authenticate requests from control-plane (must match BUILD_WORKER_SECRET in control-plane)
X44_AUTH_TOKEN="your-shared-build-worker-secret"

# Cloudflare R2 S3-compatible API endpoint
# e.g., https://<cloudflare_account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# Cloudflare R2 API token credentials (requires read/write permissions on the bucket)
R2_ACCESS_KEY="your-r2-access-key-id"
R2_SECRET_KEY="your-r2-secret-access-key"

# Control Plane API URL (used by build-worker to post build status callbacks)
CONTROL_PLANE_URL="http://localhost:8787"
