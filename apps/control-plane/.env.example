# Better Auth Configuration
# Random string (minimum 32 characters) for auth session signing
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"
# Better Auth API base URL
BETTER_AUTH_URL="http://localhost:8787"
# Better Auth Infra (Sentinel & Dash) API key & KV URL
BETTER_AUTH_API_KEY="your-better-auth-api-key"
BETTER_AUTH_IDENTIFY_URL="https://kv.better-auth.com/projects/your-project-id"

# Frontend Dashboard URL (allowed origin & redirect target)
FRONTEND_URL="http://localhost:1844"

# Cloudflare D1 Database (used by drizzle-kit for database migrations and schema pushes)
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_DATABASE_ID="your-cloudflare-database-id"
CLOUDFLARE_D1_TOKEN="your-cloudflare-d1-api-token"

# GitHub OAuth Application (for user authentication)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# GitHub Webhook Secret (used to verify incoming push events for auto-deployments)
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# URLs & Secrets for Control Plane & Build Worker
WORKER_URL="http://localhost:8787"
BUILD_WORKER_URL="http://localhost:8080"
# Shared secret for authenticating requests between control-plane and build-worker (matches X44_AUTH_TOKEN in build-worker)
BUILD_WORKER_SECRET="your-shared-build-worker-secret"
