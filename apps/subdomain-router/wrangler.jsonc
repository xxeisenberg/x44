{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subdomain-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "x44-deployments",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x44",
      "database_id": "af2c3655-5158-4f28-9b82-b80629ae6b86",
      "remote": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
